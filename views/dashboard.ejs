<!doctype html><html lang="en"><head><%- include("partials/head") %><title>Dashboard · JSON API Platform</title></head><body><%- include("partials/nav") %><main class="container"><div class="page-heading"><div><p class="eyebrow">WORKSPACE</p><h1>My APIs</h1><p class="muted">Create and manage your JSON endpoints.</p></div><a class="button" href="/apis/new">＋ Create API</a></div><% if (success) { %><div class="alert success"><%= success %></div><% } %><% if (!apis.length) { %><div class="empty-state"><div class="empty-icon">{ }</div><h2>No APIs yet</h2><p class="muted">Create your first JSON API to generate a raw GET endpoint.</p><a class="button" href="/apis/new">Create your first API</a></div><% } else { %><div class="api-grid"><% apis.forEach(api => { const url = `${baseUrl}/public-api/${api.slug}`; %><article class="api-card"><div class="card-top"><div><h2><%= api.name %></h2><code><%= api.slug %></code></div><span class="badge <%= api.published ? 'published' : 'private' %>"><%= api.published ? 'PUBLIC GET' : 'PRIVATE' %></span></div><% if (api.published) { %><p class="endpoint"><span>GET</span><code><%= url %></code></p><% } else { %><p class="muted small-text">Not public. Edit this API to publish its GET endpoint.</p><% } %><details class="json-preview"><summary>View JSON data</summary><pre><%= JSON.stringify(api.jsonData, null, 2) %></pre></details><div class="card-actions"><a class="button secondary" href="/apis/<%= api._id %>/edit">Edit</a><form method="post" action="/apis/<%= api._id %>/delete" onsubmit="return confirm('Delete this API permanently?')"><button class="button danger" type="submit">Delete</button></form><% if (api.published) { %><button class="button secondary" type="button" data-url="<%= url %>" onclick="copyUrl(this)">Copy URL</button><a class="button secondary" target="_blank" rel="noopener" href="/public-api/<%= api.slug %>">Open raw</a><% } %></div></article><% }) %></div><% } %><footer>Only published endpoints are publicly readable. Editing and deleting always require login.</footer></main><script>function copyUrl(b){navigator.clipboard.writeText(b.dataset.url).then(()=>{let old=b.textContent;b.textContent='Copied!';setTimeout(()=>b.textContent=old,1300)}).catch(()=>prompt('Copy this URL:',b.dataset.url))}</script></body></html>