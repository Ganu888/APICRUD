<!doctype html><html lang="en"><head><%- include("partials/head") %><title><%= pageTitle %> · JSON API Platform</title></head><body><%- include("partials/nav") %><main class="container narrow"><div class="page-heading"><div><p class="eyebrow">API EDITOR</p><h1><%= pageTitle %></h1><p class="muted">Paste a JSON object or array and choose whether to publish it.</p></div></div><% if (error) { %><div class="alert error"><%= error %></div><% } %><form class="panel form-panel" method="post" action="<%= action %>"><label>API name</label><input name="name" value="<%= api.name || '' %>" placeholder="Device Keys" required maxlength="120"><label>Endpoint slug</label><input name="slug" value="<%= api.slug || '' %>" placeholder="device-keys" required pattern="[a-z0-9][a-z0-9-]{1,79}"><p class="hint">Use 2–80 lowercase letters, numbers or hyphens. Example: device-keys</p><label>JSON data</label><textarea id="jsonText" name="jsonText" rows="17" spellcheck="false" required><%= api.jsonText || '' %></textarea><div class="editor-tools"><button class="button secondary" type="button" onclick="formatJson()">Format JSON</button><span id="json-status" class="muted"></span></div><label class="checkbox-row"><input type="checkbox" name="published" <%= api.published ? 'checked' : '' %>> Publish public GET endpoint (anyone with URL can read)</label><div class="form-actions"><button class="button" type="submit" onclick="return validateJson()">Save API</button><a class="button secondary" href="/dashboard">Cancel</a></div></form></main><script>function formatJson(){let b=document.getElementById('jsonText');try{b.value=JSON.stringify(JSON.parse(b.value),null,2);document.getElementById('json-status').textContent='Valid JSON'}catch(e){document.getElementById('json-status').textContent='Invalid JSON: '+e.message}}function validateJson(){let b=document.getElementById('jsonText');try{let v=JSON.parse(b.value);if(v===null||typeof v!=='object')throw Error('Enter a JSON object or array.');return true}catch(e){document.getElementById('json-status').textContent='Invalid JSON: '+e.message;b.focus();return false}}</script></body></html>