<!doctype html><html lang="en"><head><%- include("partials/head") %><title>Manage Users · JSON API Platform</title></head><body><%- include("partials/nav") %><main class="container"><div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Manage users</h1><p class="muted">Create accounts for people allowed to use the platform.</p></div></div><% if (success) { %><div class="alert success"><%= success %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><div class="two-column"><section class="panel"><h2>Create user account</h2><form method="post" action="/admin/users"><label>Username</label><input name="username" required minlength="3" maxlength="60" value="<%= form.username || '' %>" placeholder="ganesh"><label>Temporary password</label><input type="password" name="password" required minlength="8" placeholder="At least 8 characters"><p class="hint">Share the password privately. Passwords are stored as BCrypt hashes.</p><button class="button" type="submit">Create user</button></form></section><section class="panel"><h2>Existing accounts</h2><% users.forEach(u => { %><div class="user-row"><div><strong><%= u.username %></strong><div class="muted small-text"><%= u.role %></div></div><span class="badge <%= u.role === 'ADMIN' ? 'published' : 'private' %>"><%= u.role %></span></div><% }) %></section></div></main></body></html>